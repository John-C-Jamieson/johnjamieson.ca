---
// The home page (ARCHITECTURE §5.2): the story, built from the résumé and the
// site's own words.
import Base from "../layouts/Base.astro";
import CareerPath from "../components/CareerPath.astro";
import Figures from "../components/Figures.astro";
import Hero from "../components/Hero.astro";
import Principles from "../components/Principles.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Skills from "../components/Skills.astro";
import { loadContent } from "../lib/content.ts";

const content = loadContent();
---

<Base description={content.site.description}>
  <Hero content={content} />
  <Figures content={content} />
  <SelectedWork content={content} />
  <CareerPath content={content} />
  <Principles content={content} />
  <Skills content={content} />
</Base>
