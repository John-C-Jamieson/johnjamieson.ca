---
// Skills and education, in the résumé's own groups.
import type { Content } from "../lib/content.ts";

interface Props {
  content: Content;
}

const { skills, education } = Astro.props.content.resume;
const credential = (e: (typeof education)[number]) => [e.studyType, e.area].filter(Boolean).join(", ");
---

<section class="section" aria-labelledby="skills-title">
  <div class="wrap columns">
    <div>
      <h2 id="skills-title" class="section-title">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div class="row">
              <dt>{s.name}</dt>
              <dd>{s.keywords.join(", ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div>
      <h2 class="section-title">Education</h2>
      <ul class="education">
        {
          education.map((e) => (
            <li>
              <span class="credential">{credential(e)}</span>
              <span class="school">
                {e.institution} · {e.endDate}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-8);
  }

  .skills {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-weight: 650;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  .education {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }

  .education li {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .credential {
    display: block;
    font-weight: 650;
  }

  .school {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 56rem) {
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
