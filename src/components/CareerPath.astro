---
// The career path: phases from the site's words, sized by the years each
// covers, with the jobs and breaks in each, oldest first.
import { shortDate } from "../lib/content.ts";
import type { Content } from "../lib/content.ts";

interface Props {
  content: Content;
}

const { phases, site } = Astro.props.content;
const { title, intro } = site.sections.path;
const thisYear = new Date().getFullYear();
// Widths come from classes (grow-1 to grow-16), not inline styles, which the
// CSP would block.
const grow = (start: number, end: number | null) => `grow-${Math.min((end ?? thisYear) - start + 1, 16)}`;
---

<section id="path" class="section" aria-labelledby="path-title">
  <div class="wrap">
    <h2 id="path-title" class="section-title">{title}</h2>
    {intro && <p class="section-intro">{intro}</p>}
    <ol class="path">
      {
        phases.map((p, i) => (
          <li class={`phase phase-${Math.min(i + 1, 3)} ${grow(p.startYear, p.endYear)}`}>
            <div class="bar" aria-hidden="true" />
            <p class="years tnum">
              {p.startYear}–{p.endYear ?? "now"}
            </p>
            <h3>{p.label}</h3>
            <ul class="entries">
              {[...p.entries].reverse().map((e) => (
                <li>
                  <span class="name">{e.name}</span>
                  {e.type === "job" && <span class="role">{e.position}</span>}
                  <span class="dates tnum">
                    {shortDate(e.startDate)} – {shortDate(e.endDate)}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .path {
    display: flex;
    gap: var(--space-4);
    list-style: none;
  }

  .phase {
    flex: 1 1 0;
    min-width: 9rem;
  }

  .grow-1 { flex-grow: 1; }
  .grow-2 { flex-grow: 2; }
  .grow-3 { flex-grow: 3; }
  .grow-4 { flex-grow: 4; }
  .grow-5 { flex-grow: 5; }
  .grow-6 { flex-grow: 6; }
  .grow-7 { flex-grow: 7; }
  .grow-8 { flex-grow: 8; }
  .grow-9 { flex-grow: 9; }
  .grow-10 { flex-grow: 10; }
  .grow-11 { flex-grow: 11; }
  .grow-12 { flex-grow: 12; }
  .grow-13 { flex-grow: 13; }
  .grow-14 { flex-grow: 14; }
  .grow-15 { flex-grow: 15; }
  .grow-16 { flex-grow: 16; }

  .bar {
    height: 0.75rem;
    border-radius: 999px;
    background: var(--phase-1);
  }

  .phase-2 .bar {
    background: var(--phase-2);
  }

  .phase-3 .bar {
    background: var(--phase-3);
  }

  .years {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  h3 {
    margin-top: var(--space-1);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .entries {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    list-style: none;
  }

  .name {
    display: block;
    font-weight: 650;
  }

  .role {
    display: block;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .dates {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 56rem) {
    .path {
      flex-direction: column;
      gap: var(--space-6);
    }

    .phase {
      flex: none;
    }
  }
</style>
