---
// Key figures: numbers from the résumé, each with the site's short label.
import type { Content } from "../lib/content.ts";

interface Props {
  content: Content;
}

const { figures } = Astro.props.content;
---

<section class="section" aria-labelledby="figures-title">
  <div class="wrap">
    <h2 id="figures-title" class="section-title">At a glance</h2>
    <ul class="figures">
      {
        figures.map((f) => (
          <li>
            <p class="value tnum">{f.value}</p>
            <p class="label">{f.label}</p>
            <p class="source">{f.job.name}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
  }

  li {
    padding-top: var(--space-4);
    border-top: 3px solid var(--accent);
  }

  .value {
    color: var(--accent-strong);
    font-size: var(--step-figure);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .label {
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: 0.975rem;
    line-height: 1.45;
  }

  .source {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 56rem) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }
  }
</style>
